# Supabase — leave both blank to run the public site in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary — required only for uploads from /admin.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Business contact details (WhatsApp digits only, no + or spaces).
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_CONTACT_PHONE=+91 XXXXX XXXXX
VITE_CONTACT_EMAIL=hello@omsaisports.com
